{
  "name": "roll-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.8.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run src/tests scripts/tests/unit --environment jsdom",
    "coverage": "vitest run src/tests scripts/tests/unit --environment jsdom --coverage --coverage.provider=v8 --coverage.reportsDirectory=coverage/frontend --coverage.include='src/**/*.ts' --coverage.include='scripts/**/*.ts' --coverage.exclude='src/tests/**' --coverage.exclude='scripts/tests/**' --coverage.reporter=text --coverage.reporter=json --coverage.reporter=json-summary --coverage.reporter=html --coverage.thresholds.perFile --coverage.thresholds.100",
    "test:native": "npm run coverage:rust-unit && npm run test:rust-integration && npm run test:native-smoke && npm run coverage:native-report",
    "test:offline": "bwrap --unshare-net --dev-bind / / --proc /proc npm run test:native",
    "test:probes": "vitest run scripts/tests/probes.test.ts",
    "coverage:verify": "vitest run scripts/tests/reports.test.ts",
    "check": "npm run coverage && npm run build && npm run test:offline && npm run test:probes && npm run coverage:verify && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "tauri": "tauri",
    "coverage:rust-unit": "vitest run tests/native-coverage.test.ts -t '^unit coverage$'",
    "test:rust-integration": "vitest run tests/native-coverage.test.ts -t '^integration tests$'",
    "test:native-smoke": "dbus-run-session -- xvfb-run -a vitest run tests/native.test.ts",
    "coverage:native-report": "vitest run tests/native-coverage.test.ts -t '^native coverage report$'",
    "test:backend-probe": "bwrap --unshare-net --dev-bind / / --proc /proc vitest run tests/native-coverage.test.ts -t '^backend probe coverage$'",
    "test:native-probe": "bwrap --unshare-net --dev-bind / / --proc /proc npm run test:native-probe:stages",
    "test:native-probe:stages": "vitest run tests/native-coverage.test.ts -t '^reset native probe$' && npm run test:native-smoke && vitest run tests/native-coverage.test.ts -t '^native JSON report$'"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.6.1",
    "@vitest/coverage-v8": "5.0.1",
    "jsdom": "30.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1"
  }
}
