{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Extraction, acquisition and stored-history commands for the main window only.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "allow-extract-automatically",
    "allow-extract-from-file",
    "allow-cancel-acquisition",
    "allow-retrieve-history",
    "allow-commit-import",
    "allow-discard-import",
    "allow-history-page"
  ]
}
