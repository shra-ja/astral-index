{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Extraction, acquisition, stored-history, About, backup and restore commands for the main window only.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "allow-extract-automatically",
    "allow-extract-from-file",
    "allow-cancel-acquisition",
    "allow-retrieve-history",
    "allow-commit-import",
    "allow-discard-import",
    "allow-history-page",
    "allow-last-import",
    "allow-saved-accounts",
    "allow-history-status",
    "allow-app-info",
    "allow-reveal-data-folder",
    "allow-open-issues-page",
    "allow-save-backup",
    "allow-choose-restore",
    "allow-cancel-restore",
    "allow-confirm-restore"
  ]
}
