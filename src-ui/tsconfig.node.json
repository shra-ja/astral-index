// Frontend build tooling that runs in Node: the Vite config and its module.
{
  "extends": "@tsconfig/node26/tsconfig.json",
  "include": ["vite.config.ts", "eslint.config.ts", "build/**/*.ts"],
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  }
}
