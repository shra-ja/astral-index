// Tooling that runs in Node: the Vite config, scripts and their tests, and native tests.
{
  "extends": "@tsconfig/node26/tsconfig.json",
  "include": ["vite.config.ts", "scripts/**/*.ts", "tests/**/*.ts"],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  }
}
