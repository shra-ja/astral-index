// Repository code that runs in Node: the Vitest config, the tooling and its unit
// tests, and the repository-level verification in `tests/`.
{
  "extends": "@tsconfig/node26/tsconfig.json",
  "include": ["vitest.config.ts", "tooling/**/*.ts", "tests/**/*.ts"],
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  }
}
